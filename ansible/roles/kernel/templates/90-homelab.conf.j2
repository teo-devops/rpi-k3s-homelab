# Gestionado por Ansible (rpi-k3s-homelab, rol kernel). No editar a mano.
{% for key, value in kernel_sysctl.items() %}
{{ key }} = {{ value }}
{% endfor %}

# systemd activa rp_filter estricto en todas las interfaces, incluidas las que
# Cilium crea para cada pod (lxc*). Eso descarta tráfico legítimo de los pods.
# Recomendación de la documentación de Cilium:
net.ipv4.conf.lxc*.rp_filter = 0
